# ---------------------------------------------------------------------------
# Neyra Rijschool — environment variables
# ---------------------------------------------------------------------------
# Copy this file to `.env.local` and fill in real values to enable email.
# If these are left empty, the registration form runs in DEMO MODE:
# submissions are validated and confirmed to the user, but no email is sent.
# The website never crashes when email is not configured.
# ---------------------------------------------------------------------------

# Resend API key — https://resend.com/api-keys
RESEND_API_KEY=

# Where new registration requests are delivered (the driving school inbox)
CONTACT_EMAIL=info@neyrarijschool.nl

# Verified sender address in Resend (e.g. "Neyra Rijschool <noreply@neyrarijschool.nl>")
FROM_EMAIL=onboarding@resend.dev

# Public site URL (used for canonical URLs, sitemap and structured data)
NEXT_PUBLIC_SITE_URL=https://www.neyrarijschool.nl
